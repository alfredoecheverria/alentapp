# Stage 1: deps — Instalación de dependencias
FROM node:22-alpine AS deps

WORKDIR /app

# Copiar los package.json de la raíz y de cada workspace
# (npm necesita la estructura completa para resolver el workspace)
COPY package.json package-lock.json ./
COPY packages/web/package.json ./packages/web/
COPY packages/shared/package.json ./packages/shared/

# Instalación limpia y reproducible usando el lockfile de la raíz
RUN npm ci

# Stage 2: build — Compilación con Vite
FROM node:22-alpine AS build

WORKDIR /app

# Traer node_modules instalados en la etapa anterior
COPY --from=deps /app/node_modules ./node_modules

# Copiar el código fuente del workspace web y el paquete shared
COPY packages/web/ ./packages/web/
COPY packages/shared/ ./packages/shared/

# Ejecutar el build de Vite desde el workspace web
WORKDIR /app/packages/web
RUN npm run build

# Stage 3: runtime — Servidor nginx
FROM nginx:stable-alpine AS runtime

# Eliminar la configuración default de nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiar configuración personalizada (gzip, cache, security headers, SPA)
COPY packages/web/nginx.conf /etc/nginx/conf.d/app.conf

# Copiar únicamente los archivos estáticos generados por Vite
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Ajustar permisos para correr como usuario no-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

# Healthcheck contra localhost:80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]