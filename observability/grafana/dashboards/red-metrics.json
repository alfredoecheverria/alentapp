{
  "__inputs": [],
  "__requires": [],
  "title": "RED - Alentapp API",
  "version": 2,
  "schemaVersion": 40,
  "panels": [
    {
      "id": 1,
      "title": "Requests por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tasa de error %",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(http_requests_errors_total[10m])) / sum(rate(http_requests_total[10m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_requests_duration_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_requests_duration_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Distribución por status code",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status_code)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memoria del proceso",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "gauge",
      "targets": [
        {
          "expr": "process_memory_usage"
        }
      ]
    },
    {
      "id": 6,
      "title": "Top 5 endpoints más lentos",
      "datasource": { "type": "prometheus", "uid": "prometheus-src" },
      "type": "barchart",
      "targets": [
        {
          "expr": "topk(5, avg (http_requests_duration_bucket) by (route))"
        }
      ]
    }
  ]
}
